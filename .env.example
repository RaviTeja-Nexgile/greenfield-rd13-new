# Names of the variables docker-compose.prod.yml reads. Copy this file to .env on the
# server and fill in your own values; .env is git-ignored and must never be committed.
# Leave a value empty to use the default shown in the comment.

# Host port the app is published on (default: 3000)
APP_PORT=

# Tag of the image built from the Dockerfile (default: local)
IMAGE_TAG=
